[Unit]
Description=Odoo 19
After=network.target postgresql.service

[Service]
Type=simple

User=odoo
Group=odoo

WorkingDirectory=/opt/odoo/src/odoo

Environment="PATH=/opt/odoo/venv/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/opt/odoo/venv/bin/python /opt/odoo/src/odoo/odoo-bin -c /etc/odoo/odoo.conf

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
