    <menuitem id="menu_pps_asset_brand" name="Brands" parent="menu_pps_asset_root" action="action_pps_asset_brand" sequence="10"/>
    <menuitem id="menu_pps_asset_model" name="Models" parent="menu_pps_asset_root" action="action_pps_asset_model" sequence="20"/>
</odoo>
