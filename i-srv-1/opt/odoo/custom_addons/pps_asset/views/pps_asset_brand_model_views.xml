        <field name="name">Asset Brands</field>
        <field name="res_model">pps.asset.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_pps_asset_model" model="ir.actions.act_window">
        <field name="name">Asset Models</field>
        <field name="res_model">pps.asset.model</field>
