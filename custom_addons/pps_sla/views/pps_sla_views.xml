<odoo>
    <record id="view_pps_sla_form" model="ir.ui.view">
        <field name="name">pps.sla.form</field>
        <field name="model">pps.sla</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_default_fallback"/>
                    </group>
                    <group string="Response">
                        <field name="remote_response_time"/>
                        <field name="working_calendar_id"/>
                        <field name="onsite_response_time"/>
                    </group>
                    <group string="Coverage">
                        <field name="remote_support"/>
                        <field name="spare_parts_commitment"/>
                        <field name="loan_device_commitment"/>
                        <field name="preventive_maintenance_frequency"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pps_sla_list" model="ir.ui.view">
        <field name="name">pps.sla.list</field>
        <field name="model">pps.sla</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="remote_response_time"/>
                <field name="onsite_response_time"/>
                <field name="is_default_fallback"/>
            </list>
        </field>
    </record>

    <record id="action_pps_sla" model="ir.actions.act_window">
        <field name="name">SLA Templates</field>
        <field name="res_model">pps.sla</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pps_sla" name="SLA Templates" parent="pps_asset.menu_pps_asset_root" action="action_pps_sla" sequence="40"/>

    <record id="view_contract_form_inherit_sla" model="ir.ui.view">
        <field name="name">contract.contract.form.inherit.pps.sla</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_customer_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Service Level">
                    <field name="pps_sla_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
