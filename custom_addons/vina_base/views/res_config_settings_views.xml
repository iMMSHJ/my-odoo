<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vina_base_res_config_settings_view" model="ir.ui.view">
        <field name="name">vina.base.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Vina" name="vina">

                    <block title="General Settings">

                        <setting string="Support Email">
                            <field name="vina_support_email"/>
                        </setting>

                        <setting string="Support Phone">
                            <field name="vina_support_phone"/>
                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>

</odoo>
