<odoo>
    <record id="view_pps_asset_form" model="ir.ui.view">
        <field name="name">pps.asset.form</field>
        <field name="model">pps.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="pps_brand_id"/>
                        <field name="pps_model_id"/>
                        <field name="pps_serial_number"/>
                        <field name="pps_manufacture_date"/>
                        <field name="pps_location_id"/>
                        <field name="pps_condition_grade"/>
                        <field name="pps_condition_note"/>
                        <field name="pps_warranty_period"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pps_asset_list" model="ir.ui.view">
        <field name="name">pps.asset.list</field>
        <field name="model">pps.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pps_brand_id"/>
                <field name="pps_model_id"/>
            </list>
        </field>
    </record>

    <record id="action_pps_asset" model="ir.actions.act_window">
        <field name="name">Assets</field>
        <field name="res_model">pps.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pps_asset_root" name="Assets" sequence="60"/>
    <menuitem id="menu_pps_asset" name="Assets" parent="menu_pps_asset_root" action="action_pps_asset"/>
</odoo>
